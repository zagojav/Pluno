rules_version = '2';

// O site nunca fala direto com o Firestore: todo acesso passa pelo
// firebase-admin dentro das Route Handlers do Next.js, que usa uma
// credencial de serviço e ignora estas regras. Por isso aqui a regra é
// simplesmente negar qualquer leitura ou escrita vinda do cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
