# Credenciais da conta de serviço do Firebase Admin.
# Console do Firebase > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada (gera um JSON com estes três valores).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada do JSON entre aspas, mantendo os "\n" como estão.
FIREBASE_PRIVATE_KEY=""

# Email que recebe pedidos de exclusão de dados (aparece em /privacidade).
CONTATO_EMAIL=

# URL pública do site, usada para montar os links de indicação e a imagem
# de Open Graph (ex: https://pluno.vercel.app).
NEXT_PUBLIC_URL_SITE=
